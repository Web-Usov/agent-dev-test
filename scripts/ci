#!/usr/bin/env bash
set -Eeuo pipefail

required_files=(
  "README.md"
  "AGENTS.md"
  "docs/constitution.md"
  "docs/development-process.md"
  "docs/commands.md"
  "specs/_template/spec.md"
  "specs/_template/plan.md"
  "specs/_template/tasks.md"
  ".agents/skills/README.md"
  ".agents/skills/dev-core/SKILL.md"
  ".agents/skills/dev-build/SKILL.md"
  ".agents/skills/dev-debug/SKILL.md"
  ".agents/skills/dev-review/SKILL.md"
  ".github/pull_request_template.md"
  ".github/ISSUE_TEMPLATE/feature.yml"
  ".github/ISSUE_TEMPLATE/bug.yml"
  ".github/workflows/ci.yml"
  ".github/workflows/full-ci.yml"
  ".github/workflows/package-skills.yml"
  "scripts/ci"
  "scripts/ci-full"
  "scripts/diagnostics"
  "scripts/package-skills"
)

missing=0
for file in "${required_files[@]}"; do
  if [[ ! -f "$file" ]]; then
    echo "[ERROR] Отсутствует обязательный файл: $file"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  exit 1
fi

echo "[OK] Обязательная структура репозитория присутствует"

skill_names=(dev-core dev-build dev-debug dev-review)

for skill_name in "${skill_names[@]}"; do
  skill_file=".agents/skills/$skill_name/SKILL.md"

  if [[ "$(head -n 1 "$skill_file")" != "---" ]]; then
    echo "[ERROR] $skill_file должен начинаться с YAML frontmatter ('---')"
    exit 1
  fi

  frontmatter_end="$(awk 'NR > 1 && $0 == "---" { print NR; exit }' "$skill_file")"
  if [[ -z "$frontmatter_end" ]]; then
    echo "[ERROR] В $skill_file не закрыт YAML frontmatter"
    exit 1
  fi

  declared_name="$(awk -v end="$frontmatter_end" '
    NR > 1 && NR < end && /^name:[[:space:]]*/ {
      sub(/^name:[[:space:]]*/, "")
      print
      exit
    }
  ' "$skill_file")"

  description="$(awk -v end="$frontmatter_end" '
    NR > 1 && NR < end && /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      print
      exit
    }
  ' "$skill_file")"

  if [[ "$declared_name" != "$skill_name" ]]; then
    echo "[ERROR] $skill_file: name должен совпадать с каталогом ($skill_name), получено '$declared_name'"
    exit 1
  fi

  if [[ -z "$description" ]]; then
    echo "[ERROR] $skill_file: description обязателен и не должен быть пустым"
    exit 1
  fi

  if ! grep -Eq '^<!-- version: [0-9]+\.[0-9]+\.[0-9]+ -->$' "$skill_file"; then
    echo "[ERROR] $skill_file: отсутствует version comment вида <!-- version: X.Y.Z -->"
    exit 1
  fi

done

echo "[OK] Базовые workflow skills имеют корректную структуру"

bash -n scripts/ci scripts/ci-full scripts/diagnostics scripts/package-skills

echo "[OK] Базовые shell scripts синтаксически корректны"

if [[ -f scripts/project-ci ]]; then
  echo "[INFO] Запуск project-specific fast CI"
  bash scripts/project-ci
else
  echo "[INFO] scripts/project-ci не найден — выполнены только проверки шаблона"
fi

echo "[OK] Fast CI завершён"
